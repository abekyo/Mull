          "stringUnit": {
            "state": "translated",
            "value": "更新を表示"
          }
        }
      }
    },
    "Shows or conceals the API key in plain text": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーを平文で表示／非表示にします"
