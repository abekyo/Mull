        }
      }
    },
    "A newer version is ready. Your place on the page is kept until you ask for it.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい版があります。押すまで表示位置は変わりません。"
