          }
        }
      }
    },
    "A folder needs at least one character that can go in a folder name.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ名には、フォルダ名に使える文字が1つ以上必要です。"
