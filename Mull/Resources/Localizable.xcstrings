    },
    "Show key": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを表示"
          }
        }
      }
    },
    "Show me ~/mull first…": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に ~/mull を見せて…"
