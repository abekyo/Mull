    "·": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "“%@” could not be removed — its file in ~/mull/memory is still in place.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除できませんでした。~/mull/memory のファイルはそのまま残っています。"
